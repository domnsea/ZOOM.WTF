#!/bin/bash
# sch — shell. Not osascript.
#   sch elevate <script> [args...]   re-run a script as root via sudo
#   sch root <shell-text>            run a shell snippet as root via sudo
#   sch say <title> <message>        print and wait for Return if a TTY
#   sch note <title> <message>       print, do not wait
#   sch stop <title> <message>       print an error
set -u

cmd="${1:-}"
[ -n "$cmd" ] && shift

elevate() {
  local target="${1:-}"
  shift || true
  if [ -z "$target" ] || [ ! -f "$target" ]; then
    printf '%s\n' "sch: missing script" >&2
    exit 2
  fi
  if [ "$(id -u)" -eq 0 ]; then
    exec /bin/bash "$target" "$@"
  fi
  exec /usr/bin/sudo -p "Password: " /bin/bash "$target" "$@"
}

root() {
  local snippet="${1:-}"
  if [ "$(id -u)" -eq 0 ]; then
    exec /bin/bash -c "$snippet"
  fi
  exec /usr/bin/sudo -p "Password: " /bin/bash -c "$snippet"
}

say() {
  local title="${1:-1132.WTF}"
  local message="${2:-}"
  printf '\n=== %s ===\n%s\n\n' "$title" "$message"
  if [ -t 0 ]; then
    printf '%s' "Press Return. "
    read -r _ || true
    printf '\n'
  fi
}

note() {
  printf '%s — %s\n' "${1:-1132.WTF}" "${2:-}"
}

stop() {
  printf '\n=== %s ===\n%s\n\n' "${1:-1132.WTF}" "${2:-}" >&2
}

case "$cmd" in
  elevate) elevate "$@" ;;
  root) root "${1:-}" ;;
  say) say "${1:-}" "${2:-}" ;;
  note) note "${1:-}" "${2:-}" ;;
  stop) stop "${1:-}" "${2:-}" ;;
  *)
    printf '%s\n' "sch: use elevate|root|say|note|stop" >&2
    exit 2
    ;;
esac
