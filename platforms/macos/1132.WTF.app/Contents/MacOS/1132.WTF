#!/bin/bash
#
# 1132.WTF app entry point for macOS.
#
# Double-clicked, it shows a branded window (logo + the action list) and
# runs the picked action. Started by the login item, it runs a level 1
# reset with no interface.

set -u
set -o pipefail

APP_NAME="1132.WTF"
APP_VERSION="1.0.33"
APP_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
export APP_ROOT
ENGINE="$APP_ROOT/Contents/Resources/1132wtf-engine.sh"
GUI="$APP_ROOT/Contents/Resources/1132wtf-gui.jxa"
ICON="$APP_ROOT/Contents/Resources/AppIcon.icns"
LOG_DIR="$HOME/Library/Logs/$APP_NAME"

mkdir -p "$LOG_DIR"

# Old copies in /Applications used bundle id wtf.fix1132.mac. macOS then
# redirected a double-click of this app to that old copy, which opened a
# web page. Kill that login item so only THIS copy can run.
OLD_AGENT="$HOME/Library/LaunchAgents/wtf.fix1132.mac.plist"
OLD_AGENT12="$HOME/Library/LaunchAgents/wtf.fix1132.mac.12.plist"
OLD_AGENT13="$HOME/Library/LaunchAgents/wtf.fix1132.mac.13.plist"
OLD_AGENT14="$HOME/Library/LaunchAgents/wtf.fix1132.mac.14.plist"
OLD_AGENT15="$HOME/Library/LaunchAgents/wtf.fix1132.mac.15.plist"
OLD_AGENT16="$HOME/Library/LaunchAgents/wtf.fix1132.mac.16.plist"
OLD_AGENT17="$HOME/Library/LaunchAgents/wtf.fix1132.mac.17.plist"
OLD_AGENT18="$HOME/Library/LaunchAgents/wtf.fix1132.mac.18.plist"
OLD_AGENT19="$HOME/Library/LaunchAgents/wtf.fix1132.mac.19.plist"
OLD_AGENT20="$HOME/Library/LaunchAgents/wtf.fix1132.mac.20.plist"
OLD_AGENT21="$HOME/Library/LaunchAgents/wtf.fix1132.mac.21.plist"
OLD_AGENT22="$HOME/Library/LaunchAgents/wtf.fix1132.mac.22.plist"
OLD_AGENT23="$HOME/Library/LaunchAgents/wtf.fix1132.mac.23.plist"
OLD_AGENT24="$HOME/Library/LaunchAgents/wtf.fix1132.mac.24.plist"
OLD_AGENT25="$HOME/Library/LaunchAgents/wtf.fix1132.mac.25.plist"
OLD_AGENT26="$HOME/Library/LaunchAgents/wtf.fix1132.mac.26.plist"
OLD_AGENT27="$HOME/Library/LaunchAgents/wtf.fix1132.mac.27.plist"
OLD_AGENT28="$HOME/Library/LaunchAgents/wtf.fix1132.mac.28.plist"
OLD_AGENT29="$HOME/Library/LaunchAgents/wtf.fix1132.mac.29.plist"
OLD_AGENT30="$HOME/Library/LaunchAgents/wtf.fix1132.mac.30.plist"
OLD_AGENT31="$HOME/Library/LaunchAgents/wtf.fix1132.mac.31.plist"
OLD_AGENT32="$HOME/Library/LaunchAgents/wtf.fix1132.mac.32.plist"
for agent in "$OLD_AGENT" "$OLD_AGENT12" "$OLD_AGENT13" "$OLD_AGENT14" "$OLD_AGENT15" "$OLD_AGENT16" "$OLD_AGENT17" "$OLD_AGENT18" "$OLD_AGENT19" "$OLD_AGENT20" "$OLD_AGENT21" "$OLD_AGENT22" "$OLD_AGENT23" "$OLD_AGENT24" "$OLD_AGENT25" "$OLD_AGENT26" "$OLD_AGENT27" "$OLD_AGENT28" "$OLD_AGENT29" "$OLD_AGENT30" "$OLD_AGENT31" "$OLD_AGENT32"; do
  /bin/launchctl bootout "gui/$(id -u)" "$agent" >/dev/null 2>&1 ||
    /bin/launchctl unload "$agent" >/dev/null 2>&1 || true
  rm -f "$agent"
done
/usr/bin/killall -9 applet >/dev/null 2>&1 || true

# If Gatekeeper let us in once, drop the download flag so the next launch
# does not show the same dialog.
xattr -cr "$APP_ROOT" >/dev/null 2>&1 || true
chmod +x "$ENGINE" >/dev/null 2>&1 || true

TERM_STEP="$APP_ROOT/Contents/Resources/term_step1.command"

fail_dialog() {
  printf '%s\n' "$1" >&2
}

if [ ! -f "$ENGINE" ]; then
  fail_dialog "The engine is missing from this app bundle:

$ENGINE

Re-extract the package without changing what is inside $APP_NAME.app."
  exit 1
fi
chmod +x "$ENGINE" 2>/dev/null || true

run_engine() {
  "$ENGINE" "$@" 2>&1
}

# ------------------------------------------------------- non-interactive mode

if [ "${1:-}" = "--background" ]; then
  WTF1132_NO_LAUNCH=1 run_engine fix >>"$LOG_DIR/background.log" 2>&1
  exit $?
fi

if [ $# -gt 0 ]; then
  run_engine "$@"
  exit $?
fi

# ------------------------------------------------------------ Terminal STEP 1
# sudo in Terminal. 1132wtf-gui.jxa is unused.

if [ -t 0 ]; then
  exec /bin/bash "$APP_ROOT/Contents/Resources/launch_fresh_zoom.sh"
fi
/bin/chmod +x "$TERM_STEP" >/dev/null 2>&1 || true
/usr/bin/open -a Terminal "$TERM_STEP"
exit 0
