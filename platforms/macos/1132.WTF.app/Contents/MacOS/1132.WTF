#!/bin/bash
#
# 1132.WTF app entry point for macOS.
#
# Double-clicked, it shows a native chooser and runs the picked action.
# Started by the login item, it runs a level 1 reset with no interface.

set -u
set -o pipefail

APP_NAME="1132.WTF"
APP_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
export APP_ROOT
ENGINE="$APP_ROOT/Contents/Resources/1132wtf-engine.sh"
LOG_DIR="$HOME/Library/Logs/$APP_NAME"

mkdir -p "$LOG_DIR"

# If Gatekeeper let us in once, drop the download flag so the next launch
# does not show the same dialog.
xattr -cr "$APP_ROOT" >/dev/null 2>&1 || true
chmod +x "$ENGINE" >/dev/null 2>&1 || true

applescript_quote() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

fail_dialog() {
  /usr/bin/osascript -e "display dialog \"$(applescript_quote "$1")\" \
    buttons {\"OK\"} default button \"OK\" with icon stop with title \"$APP_NAME\"" >/dev/null 2>&1 || true
}

if [ ! -f "$ENGINE" ]; then
  fail_dialog "The engine is missing from this app bundle:

$ENGINE

Re-extract the package without changing what is inside $APP_NAME.app."
  exit 1
fi
chmod +x "$ENGINE" 2>/dev/null || true

run_engine() {
  # Engine output goes to the terminal, its own log file, and back to us.
  "$ENGINE" "$@" 2>&1
}

# ------------------------------------------------------- non-interactive mode

if [ "${1:-}" = "--background" ]; then
  run_engine fix >>"$LOG_DIR/background.log" 2>&1
  exit $?
fi

# Allow the bundle to be driven directly for scripting or troubleshooting:
#   1132.WTF.app/Contents/MacOS/1132.WTF status
if [ $# -gt 0 ]; then
  run_engine "$@"
  exit $?
fi

# ------------------------------------------------------------ chooser mode

OPT_FIX="STEP 1 - Fix Zoom"
OPT_DEEP="STEP 2 - Deep fix (only if STEP 1 still fails)"
OPT_BROWSER="STEP 3 - Join in browser"
OPT_STATUS="Status"
OPT_UNDO="Undo last fix"
OPT_AUTO_ON="Turn on autostart"
OPT_AUTO_OFF="Turn off autostart"
OPT_LOGS="Open logs"

CHOICE="$(/usr/bin/osascript <<OSA 2>/dev/null
set choices to {"$OPT_FIX", "$OPT_DEEP", "$OPT_BROWSER", "$OPT_STATUS", "$OPT_UNDO", "$OPT_AUTO_ON", "$OPT_AUTO_OFF", "$OPT_LOGS"}
set picked to choose from list choices with title "$APP_NAME" ¬
  with prompt "STEP 1 - click Fix Zoom" & return & ¬
  "STEP 2 - type a new name and the meeting #" & return & ¬
  "LAUNCH" ¬
  default items {"$OPT_FIX"} OK button name "Run" cancel button name "Close"
if picked is false then
  return "cancelled"
else
  return item 1 of picked
end if
OSA
)"

if [ -z "$CHOICE" ] || [ "$CHOICE" = "cancelled" ]; then
  exit 0
fi

VERB=""
NEEDS_REPORT=1
case "$CHOICE" in
  "$OPT_FIX") VERB="fix" ;;
  "$OPT_DEEP") VERB="deep-fix"; NEEDS_REPORT=0 ;;
  "$OPT_BROWSER") VERB="browser" ;;
  "$OPT_STATUS") VERB="status" ;;
  "$OPT_UNDO") VERB="restore" ;;
  "$OPT_AUTO_ON") VERB="autostart-on" ;;
  "$OPT_AUTO_OFF") VERB="autostart-off" ;;
  "$OPT_LOGS") VERB="logs"; NEEDS_REPORT=0 ;;
  *) exit 0 ;;
esac

# Level 3 asks for the meeting link first.
EXTRA=""
if [ "$VERB" = "browser" ]; then
  EXTRA="$(/usr/bin/osascript -e "text returned of (display dialog \
    \"STEP 1 - Paste the meeting link.\" & return & return & \
    \"STEP 2 - Leave empty if you just want the join page.\" & return & return & \
    \"LAUNCH\" \
    default answer \"\" with title \"$APP_NAME\" buttons {\"Cancel\", \"LAUNCH\"} \
    default button \"LAUNCH\")" 2>/dev/null || printf '__cancelled__')"
  [ "$EXTRA" = "__cancelled__" ] && exit 0
fi

if [ "$VERB" = "fix" ]; then
  # Kill Zoom before any more dialogs so a live meeting cannot freeze this app.
  /usr/bin/killall -9 zoom.us ZoomOpener ZoomAutoUpdater CptHost aomhost >/dev/null 2>&1 || true
  /usr/bin/pkill -9 -f "/zoom.us.app/" >/dev/null 2>&1 || true
  DISPLAY_NAME="$(/usr/bin/osascript -e "text returned of (display dialog \
    \"STEP 1 - Type the name Zoom should show.\" & return & return & \
    \"Do not type your old name.\" \
    default answer \"Guest\" with title \"$APP_NAME\" buttons {\"Cancel\", \"STEP 2\"} \
    default button \"STEP 2\")" 2>/dev/null || printf '__cancelled__')"
  [ "$DISPLAY_NAME" = "__cancelled__" ] && exit 0
  MEETING="$(/usr/bin/osascript -e "text returned of (display dialog \
    \"STEP 2 - Type the meeting number.\" & return & return & \
    \"Leave blank if you will type it in Zoom.\" & return & return & \
    \"LAUNCH\" \
    default answer \"\" with title \"$APP_NAME\" buttons {\"Cancel\", \"LAUNCH\"} \
    default button \"LAUNCH\")" 2>/dev/null || printf '__cancelled__')"
  [ "$MEETING" = "__cancelled__" ] && exit 0
  export WTF1132_DISPLAY_NAME="$DISPLAY_NAME"
  export WTF1132_MEETING="$MEETING"
fi

if [ "$VERB" = "deep-fix" ]; then
  CONFIRM="$(/usr/bin/osascript -e "button returned of (display dialog \
    \"STEP 1 - Type your Mac password when asked.\" & return & return & \
    \"STEP 2 - Write down the new account and password.\" & return & return & \
    \"LAUNCH - Click Switch now. Log in as that new account. Open Zoom there.\" & return & return & \
    \"Do not stay on this login. Deleting those accounts does nothing.\" \
    with title \"$APP_NAME\" buttons {\"Cancel\", \"LAUNCH\"} \
    default button \"LAUNCH\")" 2>/dev/null || printf 'Cancel')"
  [ "$CONFIRM" != "LAUNCH" ] && exit 0
fi

OUTPUT="$(run_engine "$VERB" ${EXTRA:+"$EXTRA"})"
STATUS=$?

if [ "$NEEDS_REPORT" -eq 1 ]; then
  SUMMARY="$(printf '%s\n' "$OUTPUT" | tail -n 12)"
  if [ "$STATUS" -eq 0 ] && [ "$VERB" = "fix" ]; then
    SUMMARY="Done.

LAUNCH - Zoom is opening empty.
Join with the name you typed.
Do not sign in as the old account."
  elif [ "$STATUS" -eq 0 ] && [ "$VERB" = "browser" ]; then
    SUMMARY="Done.

LAUNCH - A private browser window is opening.
Join from the browser.
Do not sign in as the old account."
  fi
  if [ "$STATUS" -eq 0 ]; then
    /usr/bin/osascript -e "display dialog \"$(applescript_quote "$SUMMARY")\" \
      buttons {\"OK\"} default button \"OK\" with title \"$APP_NAME\"" >/dev/null 2>&1 || true
  else
    BUTTON="$(/usr/bin/osascript -e "button returned of (display dialog \
      \"$(applescript_quote "$SUMMARY")\" buttons {\"Open logs\", \"OK\"} \
      default button \"OK\" with icon caution with title \"$APP_NAME\")" 2>/dev/null || printf 'OK')"
    if [ "$BUTTON" = "Open logs" ]; then
      /usr/bin/open "$LOG_DIR" >/dev/null 2>&1 || true
    fi
  fi
fi

exit "$STATUS"
